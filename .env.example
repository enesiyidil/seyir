# One Telegram bot token per role.
# Set real values only in your local .env file.
# Keep comments on separate lines.

TELEGRAM_BOT_TOKEN_MAIL=
TELEGRAM_BOT_TOKEN_MAC_M4=
TELEGRAM_BOT_TOKEN_MAC_M1=
TELEGRAM_BOT_TOKEN_WIN11=

# Numeric supergroup ID reported by seyir id-helper. It starts with a minus sign.
TELEGRAM_GROUP_ID=

# Run /id <role> in each topic (mail, mac-m4, mac-m1, win11).
TELEGRAM_TOPIC_MAIL=
TELEGRAM_TOPIC_MAC_M4=
TELEGRAM_TOPIC_MAC_M1=
TELEGRAM_TOPIC_WIN11=

# Comma-separated numeric IDs of authorized Telegram users.
TELEGRAM_ALLOWED_USER_IDS=

# Local Qwen server. An empty key falls back to ~/.omlx/settings.json.
OMLX_BASE_URL=http://127.0.0.1:8000
OMLX_MODEL=Qwen3.8-27B-oQ6e-mtp
OMLX_API_KEY=

# Use the exact account and inbox names displayed in Apple Mail.
MAIL_ACCOUNT=Exchange
MAIL_INBOX=Inbox
MAIL_INTERNAL_DOMAINS=

# Mail polling interval and batch size.
MAIL_POLL_SECONDS=60
MAIL_BATCH=15

# Cursor IDE to Telegram bridge (mac-m4).
SEYIR_BRIDGE_PORT=18765
# Optional override for the secret generated by scripts/install-hooks.py.
SEYIR_BRIDGE_SECRET=
# Optional Cursor session token for /limit.
CURSOR_SESSION_TOKEN=

# Cursor API key for summaries and topic chat via the Cursor CLI.
CURSOR_API_KEY=
# Leave blank to select an available Grok model automatically.
# Set SEYIR_GROK_MODEL to pin a model.
SEYIR_GROK_MODEL=

# Telegram RTMP destination and private stream key for window sharing.
TELEGRAM_RTMP_URL=
TELEGRAM_RTMP_KEY=
# Optional direct xAI integration.
# XAI_API_KEY=
