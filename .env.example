# BotFather -> API Token. Her botun tokenı ayrıdır.
# Değerleri yalnız bu dosyanın kopyası olan .env içine yazın.
# Satır sonuna yorum eklemeyin.

TELEGRAM_BOT_TOKEN_MAIL=
TELEGRAM_BOT_TOKEN_MAC_M4=
TELEGRAM_BOT_TOKEN_MAC_M1=
TELEGRAM_BOT_TOKEN_WIN11=

# seyir id-helper çıktısı. Süper grup numarası, eksi ile başlar.
TELEGRAM_GROUP_ID=

# Her konunun içinde /id <ad> çıktısı. Örnek adlar: mail, mac-m4, mac-m1, win11
TELEGRAM_TOPIC_MAIL=
TELEGRAM_TOPIC_MAC_M4=
TELEGRAM_TOPIC_MAC_M1=
TELEGRAM_TOPIC_WIN11=

# Kendi user_id değeriniz. Birden fazla kişi varsa virgülle ayırın: 111,222
TELEGRAM_ALLOWED_USER_IDS=

# Yerel Qwen (oMLX). Boş bırakılırsa ~/.omlx/settings.json anahtarı okunur.
OMLX_BASE_URL=http://127.0.0.1:8000
OMLX_MODEL=Qwen3.8-27B-oQ6e-mtp
OMLX_API_KEY=

# Apple Mail’de görünen hesap / gelen kutusu adları ve kurum alan adları
MAIL_ACCOUNT=Exchange
MAIL_INBOX=Gelen Kutusu
MAIL_INTERNAL_DOMAINS=

# Mail tarama
MAIL_POLL_SECONDS=60
MAIL_BATCH=15

# IDE → Telegram mirror (mac-m4)
SEYIR_BRIDGE_PORT=18765
# İsteğe bağlı özel anahtar. Boşsa install-hooks.py tarafından oluşturulan data/bridge.secret kullanılır.
SEYIR_BRIDGE_SECRET=
# İsteğe bağlı: WorkosCursorSessionToken (userId::jwt). /limit için.
CURSOR_SESSION_TOKEN=

# /ozet + konu sohbeti için Cursor API key (cursor-agent + Grok).
CURSOR_API_KEY=
# Boş bırak: listedeki en üst Grok otomatik (cache ~1 saat).
# Acil kilitlemek için: SEYIR_GROK_MODEL=grok-4.7-xhigh
SEYIR_GROK_MODEL=

# /ekran — Telegram canlı yayın (Stream with) adresi. Anahtarı sohbete yazma.
TELEGRAM_RTMP_URL=
TELEGRAM_RTMP_KEY=
# Alternatif: doğrudan xAI
# XAI_API_KEY=
